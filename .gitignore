# Build & Executables
build/
build-release/
bin/
out/

# demo/bin is the shipped GDExtension folder, not a build artifact directory.
# Git cannot re-include files under an excluded directory, so un-ignore the folder
# first and then filter its contents. Without this the .gdextension manifest never
# reached the repository and a fresh clone could not load the extension at all.
!demo/bin/
demo/bin/*
!demo/bin/*.dll
!demo/bin/*.gdextension
!demo/bin/*.uid
.vs/
*.user
*.userosv
*.sln.docstates

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CMakeLists.txt.user
Makefile
*.cmake
!CMakeLists.txt

# Compiled Objects & Libraries
*.a
*.lib
*.so
*.dylib
*.dll
!demo/bin/*.dll
*.exe
*.obj
*.o
*.pdb

# Godot 4 specifics
.godot/
*.translation
*.import

# Document Source Files & Internal Drafts
*.docx
*.doc
*.pdf
*.tmp

# Local workspace settings & notes
.local/
*.local

# IDE & OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# The godot-mcp bridge script, injected into the demo project for automated testing.
demo/mcp_interaction_server.gd
demo/mcp_interaction_server.gd.uid

# Godot copies the extension DLL aside for hot-reload while the editor runs.
demo/bin/~*.dll
