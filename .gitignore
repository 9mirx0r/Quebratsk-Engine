.godot/
*.translation
*.import

# Document Source Files & Internal Drafts
*.docx
*.doc
*.pdf
*.tmp

# Local workspace settings & notes
.local/
*.local

# IDE & OS
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db

# The godot-mcp bridge script, injected into the demo project for automated testing.
demo/mcp_interaction_server.gd
demo/mcp_interaction_server.gd.uid

# Godot copies the extension DLL aside for hot-reload while the editor runs.
demo/bin/~*.dll

# Packaged releases live on GitHub Releases, not in the repository. Seven of them were
# committed at the repo root (~11 MB) duplicating assets already published on their tags.
/quebratsk-engine-*.zip

# Working notes and reference documents that are not part of the project.
*.docx

# Third-party writing skill installed for local use, not part of the project.
.claude/skills/

# What the dock writes when someone presses Save. Generated from games on the machine,
# reproducible from them, and not something to carry in the repository.
demo/imported/

# What packaging a release produces. Rebuilt from source every time.
release_pack/
